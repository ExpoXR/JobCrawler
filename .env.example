# ---------------------------------------------------------------------------
# ExpoJobCrawler — environment configuration
# Copy to .env and adjust. Never commit a filled-in .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=info

# --- Database --------------------------------------------------------------
POSTGRES_USER=expojobcrawler
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=expojobcrawler
DATABASE_URL=postgresql://expojobcrawler:change-me-in-production@localhost:5432/expojobcrawler
DATABASE_POOL_MAX=10

# --- Redis / queues --------------------------------------------------------
# Required by the Compose stack, which starts Redis with --requirepass. Redis is
# not published to the host, so this is defence in depth rather than the only
# thing standing between the queue and the internet.
REDIS_PASSWORD=change-me-in-production
# Compose overrides this with redis://:${REDIS_PASSWORD}@redis:6379. The value
# here is for running the app directly against a local Redis without a password.
REDIS_URL=redis://localhost:6379
WORKER_CONCURRENCY=4

# --- Web -------------------------------------------------------------------
WEB_PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
PUBLIC_ROBOTS_NOINDEX=true
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Offer Google Maps alongside the default OpenStreetMap map. The deployment
# holds no Google key: whoever wants the Google map pastes their own, it stays
# in that browser tab, and it is never sent to this server. Leave this false and
# neither the option nor the Google hosts in the Content-Security-Policy exist.
# Read at build time — a change needs `docker compose up -d --build web`.
# See docs/maps.md for creating and restricting a key.
NEXT_PUBLIC_MAP_PROVIDER_ALLOW_GOOGLE=false

# --- Accounts --------------------------------------------------------------
# Searching needs no account. Administration does, and a search made while
# signed in becomes private to that account.
#
# ADMIN_EMAIL and ADMIN_PASSWORD seed the first administrator, once, on a
# deployment whose users table is still empty. Sign in, change the password in
# the dashboard, then clear ADMIN_PASSWORD from the environment.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-in-production-min-12-chars
ADMIN_USERNAME=admin

# Sliding session window, extended while in use.
AUTH_SESSION_TTL_HOURS=168
# Hard cap: never extended, so a stolen session cannot be kept alive forever.
AUTH_SESSION_ABSOLUTE_TTL_HOURS=720

# --- Security --------------------------------------------------------------
# How many reverse proxies sit in front of the app. `x-forwarded-for` is
# appended to by every hop and the client controls the leftmost entry, so only
# the last N were written by infrastructure you control. 0 means "not behind a
# proxy" and the header is ignored — leaving this wrong makes the rate limiter
# either bypassable (too high) or blind to real client addresses (too low).
TRUSTED_PROXY_HOPS=0

# Content-Security-Policy: 'report-only' | 'enforce' | 'off'.
# Ships as report-only so a policy mistake cannot take a deployment down.
# Load every page, confirm the browser console reports no violations, then set
# this to 'enforce' — report-only provides no protection.
CSP_MODE=report-only

# --- Geocoding -------------------------------------------------------------
# The production Compose stack resolves this name on expojobcrawler-internal.
GEOCODING_PROVIDER=nominatim
NOMINATIM_BASE_URL=http://nominatim:8080
NOMINATIM_PASSWORD=change-me-in-production
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter
OVERPASS_FALLBACK_URLS=https://overpass.private.coffee/api/interpreter

# Identifies this deployment to OSM services. Required by their usage policy.
CRAWLER_USER_AGENT=ExpoXR-Research/0.1 (+https://your-domain.example; admin@your-domain.example)
CRAWLER_CONTACT_EMAIL=admin@your-domain.example

# --- Crawler limits (section 36: resource limits) --------------------------
CRAWL_MAX_DOMAINS_PER_SEARCH=25
CRAWL_MAX_PAGES_PER_DOMAIN=15
CRAWL_MAX_SITEMAP_ENTRIES=2000
CRAWL_MAX_PAGE_BYTES=2000000
CRAWL_TIMEOUT_MS=15000
CRAWL_DEFAULT_DELAY_MS=1000
CRAWL_MAX_REDIRECTS=5
CRAWL_MAX_RETRIES=2
CRAWL_RESPECT_ROBOTS=true
# Comma-separated hostnames that must never be crawled.
CRAWL_BLOCKED_DOMAINS=
# Allow crawling private/loopback addresses. Keep false: SSRF protection.
CRAWL_ALLOW_PRIVATE_ADDRESSES=false

# --- Search ----------------------------------------------------------------
SEARCH_MAX_RESULTS=200
SEARCH_MAX_DURATION_MS=180000
SEARCH_DEFAULT_RADIUS_KM=50
SEARCH_MAX_RADIUS_KM=250

# --- AI providers (all optional; the system degrades to heuristics) --------
# These are the fallback. An administrator can instead configure providers at
# /admin/providers, and a stored configuration takes precedence over everything
# in this section.
#
# One of: none | openai | anthropic | gemini | ollama | openai_compatible
#
# `openai_compatible` is a wire format, not a vendor: point AI_BASE_URL at any
# server speaking OpenAI's /chat/completions — LM Studio, vLLM, llama.cpp,
# OpenRouter, Groq, Together. It needs no API key when the server wants none.
AI_PROVIDER=none
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=
AI_TEMPERATURE=0.2
AI_TIMEOUT_MS=30000
AI_MAX_CONCURRENCY=2

# Required before the dashboard will accept an API key. Without it the app
# refuses to store one rather than storing it unencrypted; providers that need
# no key still work. Generate with: openssl rand -base64 32
#
# Changing this makes every already-stored key undecryptable. Re-enter them.
SETTINGS_ENCRYPTION_KEY=

# --- Embeddings (optional; without it, lexical scoring is used) ------------
# One of: none | openai | ollama | openai_compatible
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_DIMENSIONS=1536
EMBEDDING_MAX_CONCURRENCY=2
EMBEDDING_TIMEOUT_MS=20000

# --- Re-crawl schedule (section 32) ----------------------------------------
RECRAWL_JOB_HOURS=24
RECRAWL_COMPANY_DAYS=14
RECRAWL_CANDIDATE_DAYS=30
DATA_RETENTION_DAYS=365
